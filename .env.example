NODE_ENV=development
APP_NAME=ServiceHub
WEB_PORT=3000
API_PORT=4000
DATABASE_URL=postgresql://servicehub:servicehub_dev@localhost:5432/servicehub?schema=public
REDIS_URL=redis://localhost:6379
NOTIFICATION_QUEUE_NAME=notifications
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=servicehub-private
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=miniosecret
S3_FORCE_PATH_STYLE=true
OTP_PRIMARY_CHANNEL=dev
AUTH_ALLOW_UNVERIFIED_DEV=false
OTP_FALLBACK_CHANNEL=termii
OTP_HASH_SECRET=local-only-otp-hash-secret-change-before-deploy
OTP_RESEND_SECONDS=60
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
MAILPIT_API_URL=http://localhost:8025
EMAIL_FROM=ServiceHub <no-reply@localhost>
RESEND_API_KEY=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
TERMII_API_KEY=
TERMII_SENDER_ID=ServiceHub
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
APP_ENCRYPTION_KEY=
KYC_ACTIVE_KEY_ID=local-v1
KYC_KEYRING_JSON={}
KYC_BLIND_INDEX_SECRET=
KYC_RETENTION_DAYS=365
KYC_MAX_FILE_BYTES=8000000
MAX_PORTFOLIO_PHOTOS=6
SESSION_SECRET=
JWT_ACCESS_SECRET=local-only-access-secret-change-before-deploy
AUTH_ACCESS_TTL_SECONDS=600
AUTH_REFRESH_DAYS=30
APP_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
TERMS_VERSION=draft-1
PRIVACY_VERSION=draft-1
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PHONE=
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
