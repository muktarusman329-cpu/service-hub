{
  "name": "@servicehub/db",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "node --env-file=../../.env node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "lint": "node --env-file=../../.env node_modules/prisma/build/index.js validate --schema prisma/schema.prisma",
    "typecheck": "node --env-file=../../.env node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "db:generate": "node --env-file=../../.env node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "db:migrate": "node --env-file=../../.env node_modules/prisma/build/index.js migrate dev --schema prisma/schema.prisma",
    "db:deploy": "node --env-file=../../.env node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "db:seed": "node --env-file=../../.env --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6"
  }
}
